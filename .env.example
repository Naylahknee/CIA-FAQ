# Server-only Neon pooled connection string. Never prefix this with NEXT_PUBLIC_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Public OAuth identifier from Google Cloud Console → Credentials.
GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com

# Existing account-email settings.
APP_ORIGIN=https://ciaquestions.com
AUTH_EMAIL_FROM=CIA Family Guide <accounts@ciaquestions.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx

# 32 random bytes encoded as 64 hexadecimal characters.
AUTH_ENCRYPTION_KEY=
